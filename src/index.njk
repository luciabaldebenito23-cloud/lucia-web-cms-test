      <p class="fine-print">Lucía Baldebenito · 4 min de lectura recomendada antes de decidir.</p>
    </div>

    <form class="card form-card" id="tasacionForm" novalidate action="https://formsubmit.co/inmobiliarialb.cr@gmail.com" method="POST">
