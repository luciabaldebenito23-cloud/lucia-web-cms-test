          <input type="tel" id="tTelefono" name="telefono" required autocomplete="tel" placeholder="+54 9 297 ...">
          <span class="field-error" data-error-for="tTelefono"></span>
        </div>
      </div>

      <div class="field">
        <label for="tDireccion">Dirección de la propiedad *</label>
        <input type="text" id="tDireccion" name="direccion" required placeholder="Calle, altura, piso/depto">
        <span class="field-error" data-error-for="tDireccion"></span>
      </div>

      <div class="search-row">
        <div class="field">
          <label for="tTipoProp">Tipo de propiedad *</label>
          <select id="tTipoProp" name="tipoPropiedad" required>
            <option value="">Elegí una opción</option>
            <option value="casa">Casa</option>
            <option value="departamento">Departamento</option>
            <option value="terreno">Terreno</option>
