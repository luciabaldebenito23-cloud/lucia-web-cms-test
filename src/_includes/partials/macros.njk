{% macro operacionLabel(operacion) -%}
  {%- if operacion == "venta" -%}Venta
  {%- elif operacion == "alquiler" -%}Alquiler
  {%- elif operacion == "emprendimiento" -%}Emprendimiento
  {%- else -%}{{ operacion }}
  {%- endif -%}
{%- endmacro %}

{% macro operacionTagClass(operacion) -%}
  {%- if operacion == "venta" -%}tag-purple
  {%- elif operacion == "alquiler" -%}tag-turquoise
  {%- else -%}tag-navy
  {%- endif -%}
{%- endmacro %}

{% macro precioTexto(p) -%}
  {%- if p.moneda == "USD" -%}
    USD {{ p.precio | formatNumero }}
  {%- else -%}
    $ {{ p.precio | formatNumero }}
  {%- endif -%}
  {%- if p.precio_sufijo %} {{ p.precio_sufijo }}{% endif -%}
{%- endmacro %}

{% macro propertyCard(p) %}
<article class="property-card" data-operacion="{{ p.operacion }}" data-tipo="{{ p.tipo }}" data-ciudad="{{ p.ciudad }}" data-barrio="{{ p.barrio }}" data-precio="{{ p.precio }}"{% if p.estado %} data-estado="{{ p.estado }}"{% endif %}{% if p.apta_credito %} data-apta-credito="{{ p.apta_credito }}"{% endif %}>
  <div class="property-media">
    <div class="img-placeholder has-photo">
      <img src="/{{ p.fotos[0].src }}" alt="{{ p.fotos[0].alt or p.title }}" loading="lazy">
    </div>
    <span class="tag {{ operacionTagClass(p.operacion) }}">{{ operacionLabel(p.operacion) }}</span>
  </div>
  <div class="property-body">
    <h3><a href="/propiedades/{{ p.slug }}.html">{{ p.title }}</a></h3>
    <ul class="property-meta">
      {% for item in p.meta %}<li>{{ item }}</li>{% endfor %}
    </ul>
    <p class="property-price">{{ precioTexto(p) }}</p>
    <a href="/propiedades/{{ p.slug }}.html" class="link-arrow">Ver ficha completa →</a>
  </div>
</article>
{% endmacro %}

{% macro blogCard(post) %}
<a class="blog-card blog-card-link" href="/blog/{{ post.slug }}.html">
  <div class="img-placeholder has-photo blog-media">
    <img src="/{{ post.portada }}" alt="{{ post.portada_alt }}" loading="lazy">
  </div>
  <div class="blog-body">
    <p class="eyebrow eyebrow-{{ post.eyebrow_color or 'purple' }} small">{{ post.categoria }}</p>
    <h3>{{ post.card_titulo or post.title }}</h3>
    <p>{{ post.resumen }}</p>
    <span class="blog-meta">{{ post.autor }} · {{ post.lectura }} de lectura</span>
  </div>
</a>
{% endmacro %}
